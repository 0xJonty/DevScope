# ─── Deployer Intelligence Platform — environment ───────────────────────────
# Copy to .env and fill in. Missing keys produce loud, named errors at the
# exact point they are needed; nothing falls back to mock data.

# Solana Tracker Data API key (quota'd provider — per-token ATH / token detail).
# Get one free (2,500 req/month, 3 req/s, no card): https://www.solanatracker.io/data-api
SOLANA_TRACKER_API_KEY=

# Bitquery OAuth access token — OPTIONAL. Only enriches the lifetime best-ever
# ATH, which needs the archive dataset (paid plan; the free dev tier is
# realtime-only — verified 2026-10-05). Lifetime deploy/graduated totals come
# from Solana Tracker instead. Create at https://account.bitquery.io -> API ->
# Access Tokens if you ever upgrade.
BITQUERY_API_KEY=

# pump.fun frontend API needs NO key (unofficial, keyless).
# GeckoTerminal public API needs NO key (last-resort OHLCV).

# Auth mode for the reasoning layer: "subscription" (default — uses your
# `claude` CLI login / Claude Max plan) or "api_key" (bills ANTHROPIC_API_KEY).
AUTH_MODE=subscription

# Only read when AUTH_MODE=api_key. In subscription mode a set ANTHROPIC_API_KEY
# aborts startup so it can never bill silently.
# ANTHROPIC_API_KEY=

# Server port (localhost-only bind, open http://localhost:PORT in Chrome).
PORT=5717

# Data directory (SQLite + cached token images). Default: ./data
# DATA_DIR=./data

# Profiles directory (*-PROFILE.md source of truth). Default: ./profiles
# PROFILES_DIR=./profiles
