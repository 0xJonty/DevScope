{
  "name": "devscope",
  "version": "0.7.2",
  "private": true,
  "description": "DevScope — AI-reasoned intelligence on pump.fun deployers (v1: Deployer Scan)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch --clear-screen=false src/server/index.ts",
    "start": "npm run build:web && tsx src/server/index.ts",
    "build": "tsc --noEmit && npm run build:web",
    "build:web": "npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "smoke": "tsx scripts/smoke-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "p-queue": "^9.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
